---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: l
permalink: "{{ l.prefix }}/radiofrecuencia/"
eleventyComputed:
  lang: "{{ l.code }}"
  locale: "{{ l.locale }}"
  title: "{{ i18n[l.code].radiofrecuencia.title | safe }}"
  description: "{{ i18n[l.code].radiofrecuencia.description | safe }}"
---
{%- set tx = i18n[l.code].radiofrecuencia %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalTherapy",
  "name": {{ tx.jsonld.name | dump | safe }},
  "alternateName": {{ tx.jsonld.alternateName | dump | safe }},
  "description": {{ tx.jsonld.description | dump | safe }},
  "url": "{{ site.url }}{{ l.prefix }}/radiofrecuencia/",
  "procedureType": "https://schema.org/NoninvasiveProcedure",
  "bodyLocation": [{% for b in tx.jsonld.bodyLocation %}{{ b | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "howPerformed": {{ tx.jsonld.howPerformed | dump | safe }},
  "preparation": {{ tx.jsonld.preparation | dump | safe }},
  "followup": {{ tx.jsonld.followup | dump | safe }},
  "offers": {
    "@type": "Offer",
    "price": "500",
    "priceCurrency": "EUR",
    "name": {{ tx.jsonld.offerName | dump | safe }},
    "description": {{ tx.jsonld.offerDescription | dump | safe }},
    "availability": "https://schema.org/InStock",
    "url": "{{ site.url }}{{ l.prefix }}/radiofrecuencia/"
  },
  "provider": { "@id": "{{ site.url }}/#clinic" }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
{%- for f in tx.jsonld.faq %}
    { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
</script>

<style>
  /* ─── HERO CINEMATIC ──────────────────────────────── */
  .indiba-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .indiba-hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .indiba-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .indiba-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(26,18,8,0.78) 0%, rgba(26,18,8,0.55) 50%, rgba(26,18,8,0.25) 100%);
  }
  .indiba-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 120px 0;
  }
  .indiba-hero-content { max-width: 720px; }
  .indiba-hero h1 {
    color: #fff;
    font-size: clamp(40px, 6.5vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 16px 0 20px;
  }
  .indiba-hero h1 em { font-style: italic; color: var(--gold); }
  .indiba-hero .lead {
    color: rgba(255,255,255,0.88);
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 32px;
  }
  .indiba-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .indiba-hero-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    color: rgba(255,255,255,0.78);
    font-size: 13px;
  }
  .indiba-hero-meta strong { color: #fff; }
  .indiba-hero-meta .stars { color: var(--gold); letter-spacing: 1px; font-size: 14px; }
  .indiba-hero-meta .dot { color: rgba(255,255,255,0.35); }

  /* ─── PAIN POINTS ─────────────────────────────────── */
  .indiba-pain {
    background: var(--ivory);
    padding: 96px 0;
  }
  .indiba-pain-head { text-align: center; max-width: 680px; margin: 0 auto 64px; }
  .indiba-pain-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .indiba-pain-head p { color: var(--text-mid); font-size: 16px; }
  .indiba-pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .indiba-pain-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 36px 32px;
    transition: border-color 0.3s var(--ease);
  }
  .indiba-pain-item:hover { border-color: var(--terra); }
  .indiba-pain-item h3 {
    font-size: 22px;
    line-height: 1.25;
    margin-bottom: 14px;
    color: var(--dark);
  }
  .indiba-pain-item p { color: var(--text-mid); font-size: 14px; line-height: 1.6; }

  /* ─── WHY IT WORKS — 6 reasons numbered ───────────── */
  .indiba-why {
    background: var(--sand);
    padding: 96px 0;
  }
  .indiba-why-head { max-width: 680px; margin: 0 auto 64px; text-align: center; }
  .indiba-why-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .indiba-why-head p { color: var(--text-mid); font-size: 16px; }
  .indiba-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 64px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .indiba-reason { display: flex; gap: 20px; }
  .indiba-reason-num {
    flex-shrink: 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 44px;
    line-height: 1;
    color: var(--terra-dk);
    font-weight: 500;
    margin-top: -4px;
  }
  .indiba-reason-body h3 {
    font-size: 22px;
    margin-bottom: 10px;
    line-height: 1.25;
    color: var(--dark);
  }
  .indiba-reason-body p { color: var(--text-mid); font-size: 14.5px; line-height: 1.65; }

  /* ─── MODALITIES (facial / corporal) ─────────────── */
  .indiba-modalities {
    padding: 96px 0;
    background: var(--ivory);
  }
  .indiba-mod-head { text-align: center; max-width: 680px; margin: 0 auto 56px; }
  .indiba-mod-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .indiba-mod-head p { color: var(--text-mid); font-size: 16px; }
  .indiba-mod-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .indiba-mod {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .indiba-mod-img { aspect-ratio: 16/10; overflow: hidden; }
  .indiba-mod-img img { width: 100%; height: 100%; object-fit: cover; }
  .indiba-mod-body { padding: 32px; flex: 1; display: flex; flex-direction: column; }
  .indiba-mod-body h3 {
    font-size: 28px;
    margin-bottom: 12px;
    color: var(--dark);
  }
  .indiba-mod-body p { color: var(--text-mid); font-size: 15px; line-height: 1.6; margin-bottom: 20px; }
  .indiba-mod-list { list-style: none; padding: 0; margin: 0; }
  .indiba-mod-list li {
    font-size: 14px;
    color: var(--text);
    padding: 6px 0 6px 22px;
    position: relative;
    line-height: 1.5;
  }
  .indiba-mod-list li::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    color: var(--terra);
    font-weight: 700;
  }

  /* ─── PACK GRAND SLAM (offer stack) ──────────────── */
  .indiba-pack {
    background: var(--dark);
    color: #fff;
    padding: 96px 0;
    position: relative;
    overflow: hidden;
  }
  .indiba-pack-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }
  .indiba-pack-head .eyebrow { color: var(--gold); }
  .indiba-pack-head h2 {
    color: #fff;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    margin: 12px 0 16px;
  }
  .indiba-pack-head h2 em { font-style: italic; color: var(--gold); }
  .indiba-pack-head p { color: rgba(255,255,255,0.78); font-size: 17px; }
  .indiba-pack-card {
    max-width: 720px;
    margin: 0 auto;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 2px;
    padding: 48px;
  }
  .indiba-stack-list { list-style: none; padding: 0; margin: 0 0 32px; }
  .indiba-stack-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px dashed rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.85);
    font-size: 15px;
  }
  .indiba-stack-list li:last-child { border-bottom: none; }
  .indiba-stack-list li .price {
    color: rgba(255,255,255,0.55);
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    white-space: nowrap;
  }
  .indiba-stack-totals {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.2);
    margin-bottom: 32px;
  }
  .indiba-stack-totals .label { font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
  .indiba-stack-totals .crossed { color: rgba(255,255,255,0.55); text-decoration: line-through; font-size: 22px; margin-inline-end: 16px; font-family: 'Cormorant Garamond', serif; }
  .indiba-stack-totals .final {
    font-family: 'Cormorant Garamond', serif;
    color: var(--gold);
    font-size: 56px;
    font-weight: 500;
    line-height: 1;
  }
  .indiba-stack-savings {
    text-align: center;
    color: var(--gold);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 32px;
  }
  .indiba-pack-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── TESTIMONIOS ────────────────────────────────── */
  .indiba-tests {
    background: var(--ivory);
    padding: 96px 0;
  }
  .indiba-tests-head { text-align: center; max-width: 680px; margin: 0 auto 56px; }
  .indiba-tests-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .indiba-tests-head p { color: var(--text-mid); font-size: 15px; }
  .indiba-tests-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .indiba-test {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .indiba-test-stars { color: var(--gold); font-size: 16px; letter-spacing: 1px; margin-bottom: 16px; }
  .indiba-test-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    line-height: 1.45;
    color: var(--dark);
    font-style: italic;
    margin-bottom: 24px;
    flex: 1;
  }
  .indiba-test-author {
    font-size: 13px;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .indiba-test-meta { font-size: 12px; color: var(--text-mid); letter-spacing: 0.04em; }

  /* ─── PROCESS ─────────────────────────────────────── */
  .indiba-process {
    background: var(--sand);
    padding: 96px 0;
  }
  .indiba-process-head { text-align: center; max-width: 680px; margin: 0 auto 64px; }
  .indiba-process-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .indiba-process-head p { color: var(--text-mid); font-size: 16px; }
  .indiba-steps { max-width: 800px; margin: 0 auto; }
  .indiba-step {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }
  .indiba-step:last-child { border-bottom: none; }
  .indiba-step-num {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--terra);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 500;
  }
  .indiba-step-body h3 { font-size: 22px; margin-bottom: 8px; color: var(--dark); }
  .indiba-step-body p { color: var(--text-mid); font-size: 15px; line-height: 1.6; }

  /* ─── FAQ ─────────────────────────────────────────── */
  .indiba-faq {
    background: var(--ivory);
    padding: 96px 0;
  }
  .indiba-faq-head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
  .indiba-faq-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0;
  }
  .indiba-faq-list { max-width: 800px; margin: 0 auto; }
  .indiba-faq-item {
    border-bottom: 1px solid var(--border);
  }
  .indiba-faq-q {
    width: 100%;
    background: none;
    border: none;
    padding: 24px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--dark);
    text-align: start;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    line-height: 1.3;
  }
  .indiba-faq-q .icon {
    flex-shrink: 0;
    font-size: 22px;
    color: var(--terra);
    transition: transform 0.3s var(--ease);
  }
  .indiba-faq-item.open .indiba-faq-q .icon { transform: rotate(45deg); }
  .indiba-faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    color: var(--text-mid);
    font-size: 15.5px;
    line-height: 1.7;
  }
  .indiba-faq-item.open .indiba-faq-a {
    max-height: 600px;
    padding: 0 0 28px;
  }

  /* ─── FINAL CTA ───────────────────────────────────── */
  .indiba-final {
    padding: 120px 0;
    background: var(--dark);
    color: #fff;
    text-align: center;
  }
  .indiba-final h2 {
    color: #fff;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    max-width: 760px;
    margin: 0 auto 20px;
  }
  .indiba-final h2 em { font-style: italic; color: var(--gold); }
  .indiba-final p {
    color: rgba(255,255,255,0.78);
    font-size: 17px;
    max-width: 540px;
    margin: 0 auto 36px;
  }
  .indiba-final-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 900px) {
    .indiba-pain-grid { grid-template-columns: 1fr; gap: 20px; }
    .indiba-why-grid { grid-template-columns: 1fr; gap: 32px; }
    .indiba-mod-grid { grid-template-columns: 1fr; }
    .indiba-tests-grid { grid-template-columns: 1fr; }
    .indiba-pack-card { padding: 32px 24px; }
  }
  @media (max-width: 640px) {
    .indiba-hero-inner { padding: 80px 0; }
    .indiba-pain, .indiba-why, .indiba-modalities, .indiba-pack, .indiba-tests, .indiba-process, .indiba-faq, .indiba-final { padding: 64px 0; }
    .indiba-stack-totals .final { font-size: 44px; }
  }
</style>

<!-- BREADCRUMB -->
<div class="breadcrumb">
  <div class="container">
    <a href="{{ (l.prefix + '/') | url }}">{{ i18n[l.code].chrome.breadcrumbHome }}</a>
    <span>›</span>
    <a href="{{ (l.prefix + '/services/') | url }}">{{ tx.breadcrumb.services }}</a>
    <span>›</span>
    <span>{{ tx.breadcrumb.current }}</span>
  </div>
</div>

<!-- HERO CINEMATIC -->
<section class="indiba-hero">
  <div class="indiba-hero-img">
    <picture>
      <source srcset="{{ '/images/radiofrecuencia/5796413057692451908.webp' | url }}" type="image/webp">
      <img
        src="{{ '/images/radiofrecuencia/5796413057692451908.jpg' | url }}"
        alt="{{ tx.hero.imgAlt }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1920"
        height="1080"
      />
    </picture>
  </div>
  <div class="indiba-hero-inner">
    <div class="container">
      <div class="indiba-hero-content">
        <span class="eyebrow" style="color: var(--gold);">{{ tx.hero.eyebrow_html | safe }}</span>
        <h1>{{ tx.hero.h1_html | safe }}</h1>
        <p class="lead">{{ tx.hero.lead }}</p>
        <div class="indiba-hero-ctas">
          <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-accent">{{ tx.hero.ctaPrimary }}</a>
          <a href="tel:+34656306167" class="btn btn-outline-white">{{ tx.callCta }}</a>
        </div>
        <div class="indiba-hero-meta">
          <span class="stars">★★★★★</span>
          <strong>{{ reviews.rating }} · {{ reviews.count }} {{ tx.hero.reviews }}</strong>
          <span class="dot">·</span>
          <span>{{ tx.hero.packMeta_html | safe }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAIN POINTS -->
<section class="indiba-pain">
  <div class="container">
    <div class="indiba-pain-head">
      <span class="eyebrow">{{ tx.pain.eyebrow }}</span>
      <h2>{{ tx.pain.h2 }}</h2>
      <p>{{ tx.pain.p }}</p>
    </div>
    <div class="indiba-pain-grid">
      {%- for it in tx.pain.items %}
      <div class="indiba-pain-item">
        <h3>{{ it.h3 }}</h3>
        <p>{{ it.p_html | safe }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- WHY IT WORKS -->
<section class="indiba-why">
  <div class="container">
    <div class="indiba-why-head">
      <span class="eyebrow">{{ tx.why.eyebrow }}</span>
      <h2>{{ tx.why.h2 }}</h2>
      <p>{{ tx.why.p }}</p>
    </div>
    <div class="indiba-why-grid">
      {%- for it in tx.why.items %}
      <div class="indiba-reason">
        <div class="indiba-reason-num">0{{ loop.index }}</div>
        <div class="indiba-reason-body">
          <h3>{{ it.h3 }}</h3>
          <p>{{ it.p_html | safe }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- MODALITIES -->
<section class="indiba-modalities">
  <div class="container">
    <div class="indiba-mod-head">
      <span class="eyebrow">{{ tx.mod.eyebrow }}</span>
      <h2>{{ tx.mod.h2 }}</h2>
      <p>{{ tx.mod.p }}</p>
    </div>
    <div class="indiba-mod-grid">
      <div class="indiba-mod">
        <div class="indiba-mod-img">
          <picture>
            <source srcset="{{ '/images/radiofrecuencia/112.webp' | url }}" type="image/webp">
            <img src="{{ '/images/radiofrecuencia/112.png' | url }}" alt="{{ tx.mod.card1.imgAlt }}" loading="lazy" decoding="async" width="640" height="400" />
          </picture>
        </div>
        <div class="indiba-mod-body">
          <h3>{{ tx.mod.card1.h3 }}</h3>
          <p>{{ tx.mod.card1.p }}</p>
          <ul class="indiba-mod-list">
            {%- for li in tx.mod.card1.items %}
            <li>{{ li }}</li>
            {%- endfor %}
          </ul>
        </div>
      </div>
      <div class="indiba-mod">
        <div class="indiba-mod-img">
          <picture>
            <source srcset="{{ '/images/radiofrecuencia/111.webp' | url }}" type="image/webp">
            <img src="{{ '/images/radiofrecuencia/111.png' | url }}" alt="{{ tx.mod.card2.imgAlt }}" loading="lazy" decoding="async" width="640" height="400" />
          </picture>
        </div>
        <div class="indiba-mod-body">
          <h3>{{ tx.mod.card2.h3 }}</h3>
          <p>{{ tx.mod.card2.p }}</p>
          <ul class="indiba-mod-list">
            {%- for li in tx.mod.card2.items %}
            <li>{{ li }}</li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PACK GRAND SLAM -->
<section class="indiba-pack" id="pack">
  <div class="container">
    <div class="indiba-pack-head">
      <span class="eyebrow">{{ tx.pack.eyebrow }}</span>
      <h2>{{ tx.pack.h2_html | safe }}</h2>
      <p>{{ tx.pack.p_html | safe }}</p>
    </div>
    <div class="indiba-pack-card">
      <ul class="indiba-stack-list">
        {%- for it in tx.pack.stack %}
        <li>
          <span>{{ it.label }}</span>
          <span class="price">{{ it.price }}</span>
        </li>
        {%- endfor %}
      </ul>
      <div class="indiba-stack-totals">
        <div>
          <div class="label">{{ tx.pack.totalLabel }}</div>
          <span class="crossed">{{ tx.pack.crossed }}</span>
        </div>
        <div style="text-align: end;">
          <div class="label">{{ tx.pack.priceLabel }}</div>
          <span class="final">{{ tx.pack.final_html | safe }}</span>
        </div>
      </div>
      <div class="indiba-stack-savings">{{ tx.pack.savings }}</div>
      <div class="indiba-pack-cta">
        <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-accent">{{ tx.hero.ctaPrimary }}</a>
        <a href="https://wa.me/34656306167?text={{ tx.pack.waText_html | safe }}" class="btn btn-outline-white" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
    <div class="indiba-pack-card" style="margin-top: 2rem;">
      <div class="indiba-pack-head" style="margin-bottom: 1rem;">
        <h3 style="color: #fff; font-size: clamp(22px, 3vw, 30px);">{{ tx.pack.ratesTitle }}</h3>
      </div>
      <ul class="indiba-stack-list">
        {%- for it in tx.pack.rates %}
        <li><span>{{ it.label_html | safe }}</span><span class="price">{{ it.price_html | safe }}</span></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- TESTIMONIOS -->
<section class="indiba-tests">
  <div class="container">
    <div class="indiba-tests-head">
      <span class="eyebrow">{{ tx.tests.eyebrow }}</span>
      <h2>{{ tx.tests.h2 }}</h2>
      <p>{{ tx.tests.p }}</p>
    </div>
    <div class="indiba-tests-grid">
      {%- for it in tx.tests.items %}
      <div class="indiba-test">
        <div class="indiba-test-stars">★★★★★</div>
        <p class="indiba-test-quote">{{ it.quote_html | safe }}</p>
        <div class="indiba-test-author">{{ it.author }}</div>
        <div class="indiba-test-meta">{{ it.meta }}</div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="indiba-process">
  <div class="container">
    <div class="indiba-process-head">
      <span class="eyebrow">{{ tx.process.eyebrow }}</span>
      <h2>{{ tx.process.h2 }}</h2>
      <p>{{ tx.process.p }}</p>
    </div>
    <div class="indiba-steps">
      {%- for it in tx.process.steps %}
      <div class="indiba-step">
        <div class="indiba-step-num">{{ loop.index }}</div>
        <div class="indiba-step-body">
          <h3>{{ it.h3 }}</h3>
          <p>{{ it.p }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="indiba-faq">
  <div class="container">
    <div class="indiba-faq-head">
      <span class="eyebrow">{{ tx.faq.eyebrow }}</span>
      <h2>{{ tx.faq.h2 }}</h2>
    </div>
    <div class="indiba-faq-list">
      {%- for f in tx.faq.items %}
      <div class="indiba-faq-item{% if loop.first %} open{% endif %}">
        <button class="indiba-faq-q" type="button">{{ f.q }} <span class="icon">+</span></button>
        <div class="indiba-faq-a"><p>{{ f.a_html | safe }}</p></div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="indiba-final">
  <div class="container">
    <span class="eyebrow" style="color: var(--gold);">{{ tx.final.eyebrow }}</span>
    <h2>{{ tx.final.h2_html | safe }}</h2>
    <p>{{ tx.final.p }}</p>
    <div class="indiba-final-row">
      <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-accent">{{ tx.final.cta }}</a>
      <a href="tel:+34656306167" class="btn btn-outline-white">{{ tx.callCta }}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.indiba-faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.indiba-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.indiba-faq-item').forEach((i) => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });
</script>
