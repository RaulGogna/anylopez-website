{%- set tp = i18n[lang or 'es'].partials %}
<section class="lead-strip">
  <div class="lead-strip-inner rv">
    <p class="lead-strip-label">{{ tp.leadStrip.label_html | safe }}</p>
    <form class="lead-form" id="leadForm" action="https://formspree.io/f/xrerbgdw" method="POST">
      <input type="hidden" name="_subject" value="{{ tp.leadStrip.subject }}" />
      <input type="text" name="nombre" placeholder="{{ tp.leadStrip.namePh }}" required aria-label="{{ tp.leadStrip.nameAria }}" />
      <input type="tel" name="telefono" placeholder="{{ tp.leadStrip.telPh }}" required aria-label="{{ tp.leadStrip.telAria }}" />
      <select name="tratamiento" aria-label="{{ tp.leadStrip.selAria }}">
        <option value="" disabled selected>{{ tp.leadStrip.selPh }}</option>
        {%- for o in tp.leadStrip.options %}
        <option value="{{ o.value }}">{{ o.label }}</option>
        {%- endfor %}
      </select>
      <button type="submit" class="btn btn-terra">{{ tp.leadStrip.submit }}</button>
    </form>
    <p id="leadFormMsg">{{ tp.leadStrip.msg_html | safe }}</p>
  </div>
</section>
