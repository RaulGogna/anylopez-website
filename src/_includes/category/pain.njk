{% import "category/copy.njk" as c %}
<!-- PAIN POINTS -->
<section class="cat-page-pain">
  <div class="container">
    <div class="cat-page-pain-head">
      <span class="eyebrow">{{ tx.pain.eyebrow }}</span>
      <h2>{{ tx.pain.h2 }}</h2>
      <p>{{ c.copy(tx.pain, 'p') }}</p>
    </div>
    <div class="cat-page-pain-grid">
      {%- for it in tx.pain.items %}
      <div class="cat-page-pain-item">
        <h3>{{ it.h3_html | safe }}</h3>
        <p>{{ c.copy(it, 'p') }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
