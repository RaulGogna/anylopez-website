<!-- TESTIMONIOS -->
<section class="cat-page-tests">
  <div class="container">
    <div class="cat-page-section-head">
      <span class="eyebrow">{{ tx.tests.eyebrow }}</span>
      <h2 id="cat-page-tests-title">{{ tx.tests.h2 }}</h2>
      <p>{{ tx.tests.p }}</p>
    </div>
    <div class="cat-page-tests-grid" role="region" aria-labelledby="cat-page-tests-title">
      {%- for it in tx.tests.items %}
      <div class="cat-page-test">
        <div class="cat-page-test-stars">★★★★★</div>
        <p class="cat-page-test-quote">{{ it.quote_html | safe }}</p>
        <div class="cat-page-test-author">{{ it.author }}</div>
        <div class="cat-page-test-meta">{{ it.meta }}</div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
