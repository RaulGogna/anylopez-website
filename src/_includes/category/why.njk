{% import "category/copy.njk" as c %}
<!-- WHY IT WORKS -->
<section class="cat-page-why">
  <div class="container">
    <div class="cat-page-why-head">
      <span class="eyebrow">{{ c.copy(tx.why, 'eyebrow') }}</span>
      <h2>{{ c.copy(tx.why, 'h2') }}</h2>
      <p>{{ c.copy(tx.why, 'p') }}</p>
    </div>
    <div class="cat-page-why-grid">
      {%- for it in tx.why.items %}
      <div class="cat-page-reason">
        <div class="cat-page-reason-num">0{{ loop.index }}</div>
        <div class="cat-page-reason-body">
          <h3>{{ c.copy(it, 'h3') }}</h3>
          <p>{{ c.copy(it, 'p') }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
