<script>
  document.querySelectorAll('.cat-page-faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.cat-page-faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.cat-page-faq-item').forEach((i) => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

  // Sin JS el panel «Qué incluye» queda abierto en el HTML y el botón oculto: aquí se invierte.
  const botones = [...document.querySelectorAll('.trat-card-more-btn')];
  const panelDe = (b) => document.getElementById(b.getAttribute('aria-controls'));
  const fijar = (b, abierto) => {
    b.setAttribute('aria-expanded', String(abierto));
    panelDe(b).hidden = !abierto;
  };
  botones.forEach((b) => {
    b.hidden = false;
    fijar(b, false);
    // treatment-modal.js abre el modal al pulsar en cualquier punto de una tarjeta (delegado en
    // document): un clic en el botón o en su panel no debe llegar hasta allí.
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const abrir = b.getAttribute('aria-expanded') !== 'true';
      botones.forEach((o) => fijar(o, false));
      if (abrir) fijar(b, true);
    });
    panelDe(b).addEventListener('click', (e) => e.stopPropagation());
  });
  document.addEventListener('keydown', (e) => {
    const abierto = botones.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (e.key !== 'Escape' || !abierto) return;
    fijar(abierto, false);
    abierto.focus();
  });

  const carousel = document.querySelector('.cat-page-tests-grid');
  if (carousel) {
    const sync = () => {
      if (carousel.scrollWidth > carousel.clientWidth) carousel.tabIndex = 0;
      else carousel.removeAttribute('tabindex');
    };
    new ResizeObserver(sync).observe(carousel);
  }
</script>
