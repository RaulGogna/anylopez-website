{%- set tp = i18n[lang or 'es'].partials %}
<section class="dolor-solucion-section">
  <div class="container">
    <div class="dolor-solucion-grid">

      <div class="ds-col ds-dolor rv">
        <span class="ds-eyebrow">{{ tp.dolorSolucion.dolor.eyebrow }}</span>
        <h2 class="ds-title">{{ tp.dolorSolucion.dolor.title_html | safe }}</h2>
        <p class="ds-body">{{ tp.dolorSolucion.dolor.p1_html | safe }}</p>
        <p class="ds-body">{{ tp.dolorSolucion.dolor.p2_html | safe }}</p>
        <p class="ds-body ds-emphasis">{{ tp.dolorSolucion.dolor.p3_html | safe }}</p>
      </div>

      <div class="ds-col ds-solucion rv">
        <span class="ds-eyebrow">{{ tp.dolorSolucion.solucion.eyebrow }}</span>
        <h2 class="ds-title">{{ tp.dolorSolucion.solucion.title_html | safe }}</h2>
        <p class="ds-body">{{ tp.dolorSolucion.solucion.p_html | safe }}</p>
        <ul class="ds-bullets">
          {%- for b in tp.dolorSolucion.solucion.bullets %}
          <li>
            <strong>{{ b.strong }}</strong>
            <span>{{ b.span_html | safe }}</span>
          </li>
          {%- endfor %}
        </ul>
      </div>

    </div>
  </div>
</section>
