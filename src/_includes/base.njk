<!DOCTYPE html>
{%- set l = langs | langByCode(lang or 'es') %}
{%- set t = i18n[l.code] %}
{%- set curEntry = pagesI18n | entryByUrl(page.url) %}
<html lang="{{ l.code }}"{% if l.dir == 'rtl' %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://anylopez-chat.anylopez.workers.dev https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://anylopez-chat.anylopez.workers.dev https://anylopez-booking-worker.anylopez.workers.dev https://formspree.io https://cloud.umami.is https://gateway.umami.is https://api-gateway.umami.dev; frame-src https://www.google.com https://calendar.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io;" />
  <meta name="google-site-verification" content="0dnEAfvtuu2DYhE3smoUjH2t21n3CexTdg11IIdslxM" />
  <meta name="description" content="{{ description }}" />
  <title>{{ title }}</title>

  {%- set canonicalUrl = site.url + page.url -%}
  {%- set ogImageRel = ogImage or "/images/hero-poster.webp" -%}
  {%- set ogImageAbs = site.url + ogImageRel -%}
  <link rel="canonical" href="{{ canonicalUrl }}" />

  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicon-32.png' | url }}" />
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicon-16.png' | url }}" />
  <link rel="apple-touch-icon" href="{{ '/images/favicon-32.png' | url }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="{{ locale or l.locale }}" />
  <meta property="og:title" content="{{ ogTitle or title }}" />
  <meta property="og:description" content="{{ ogDescription or description }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:image" content="{{ ogImageAbs }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle or title }}" />
  <meta name="twitter:description" content="{{ ogDescription or description }}" />
  <meta name="twitter:image" content="{{ ogImageAbs }}" />
  <meta name="theme-color" content="#7a3a1f" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  {%- if curEntry and curEntry.multilang %}
  {%- for l2 in langs %}
  <link rel="alternate" hreflang="{{ l2.hreflang }}" href="{{ site.url }}{{ curEntry.urls[l2.code] }}" />
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ curEntry.urls.es }}" />
  {%- endif %}

  <link rel="preconnect" href="https://anylopez-booking-worker.anylopez.workers.dev" />
  <link rel="preconnect" href="https://gateway.umami.is" crossorigin />
  <link rel="preconnect" href="https://maps.googleapis.com" />
  <link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/cormorant-garamond-v21-latin-300.woff2' | url }}" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/cormorant-garamond-v21-latin-300italic.woff2' | url }}" crossorigin />
  <link rel="preload" href="{{ '/assets/css/fonts.css' | url | bust }}" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="{{ '/assets/css/fonts.css' | url | bust }}" /></noscript>
  {% if page.url == "/" %}
  <link rel="preload" as="image" href="{{ '/images/hero-image.webp' | url }}" type="image/webp" fetchpriority="high" />
  {% endif %}
  <link rel="stylesheet" href="{{ '/css/styles.css' | url | bust }}" />
  <style>.lang-dropdown li a[data-lang="{{ l.code }}"] { color: var(--terra, #8b3a1a); font-weight: 600; }</style>
  {% if legalPage %}<link rel="stylesheet" href="{{ '/assets/css/legal.css' | url | bust }}" />{% endif %}

  {%- set _crumbName = t.crumbs[curEntry.key] if curEntry else null -%}
  {%- if _crumbName -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{ t.breadcrumbHome }}",
        "item": "{{ site.url }}{{ l.prefix }}/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ _crumbName }}",
        "item": "{{ site.url }}{{ page.url }}"
      }
    ]
  }
  </script>
  {%- endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "MedicalClinic",
        "@id": "{{ site.url }}/#clinic",
        "name": "AnyLopez Clínica Estética",
        "alternateName": "AnyLopez Benidorm",
        "description": "Clínica estética facial y corporal en Benidorm con 35+ años de experiencia. Especialistas en radiofrecuencia INDIBA, Ultherapy HIFU, dermapen, depilación láser, botox y rellenos.",
        "url": "{{ site.url }}/",
        "logo": "{{ site.url }}/images/logo-color-sin-fondo.webp",
        "image": [
          "{{ site.url }}/images/hero-poster.webp",
          "{{ site.url }}/images/clinica/recepcion.webp",
          "{{ site.url }}/images/clinica/cabina2.webp",
          "{{ site.url }}/images/clinica/salaespera.webp"
        ],
        "telephone": "+34656306167",
        "email": "info@anylopez.com",
        "priceRange": "€€",
        "currenciesAccepted": "EUR",
        "paymentAccepted": "Cash, Credit Card, Bizum, Bank Transfer, Financing",
        "medicalSpecialty": "Dermatologic",
        "availableLanguage": [{% for l2 in langs %}"{{ l2.schemaName }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "C/ Marqués de Comillas 4, Local 6",
          "addressLocality": "Benidorm",
          "addressRegion": "Alicante",
          "postalCode": "03501",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 38.53764,
          "longitude": -0.13294
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "10:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "16:00",
            "closes": "20:00"
          }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ reviews.rating }}",
          "reviewCount": "{{ reviews.count }}",
          "bestRating": "5",
          "worstRating": "1"
        },
        "sameAs": [
          "https://www.instagram.com/anylopez.estetica/",
          "https://www.facebook.com/anylopez.benidormespana",
          "https://twitter.com/AnyLopezClinica",
          "https://www.tiktok.com/@anylopezclinicaestetica",
          "https://www.youtube.com/@anylopez9482",
          "https://maps.app.goo.gl/v1Hvp48bfh3E7d86A"
        ],
        "areaServed": [
          { "@type": "City", "name": "Benidorm" },
          { "@type": "City", "name": "Altea" },
          { "@type": "City", "name": "Alfaz del Pi" },
          { "@type": "City", "name": "La Nucía" },
          { "@type": "City", "name": "Villajoyosa" }
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "AnyLopez Clínica Estética",
        "publisher": { "@id": "{{ site.url }}/#clinic" },
        "inLanguage": [{% for l2 in langs %}"{{ l2.bcp47 }}"{% if not loop.last %}, {% endif %}{% endfor %}]
      }
    ]
  }
  </script>
</head>
<body class="preload">

  <!-- HEADER -->
  <header class="site-header" id="siteHeader">
    <div class="header-inner">
      <a href="{{ (l.prefix + '/') | url }}" class="logo-link" aria-label="AnyLopez Clínica Estética">
        <picture>
          <source srcset="{{ '/images/logo-color-sin-fondo.webp' | url }}" type="image/webp">
          <img src="{{ '/images/logo-color-sin-fondo.png' | url }}" alt="AnyLopez" class="logo-img" width="108" height="80" fetchpriority="high" decoding="async" />
        </picture>
      </a>

      <nav class="nav-links" id="navMenu">
        <a href="{{ (l.prefix + '/') | url }}" class="{{ 'active' if page.url == l.prefix + '/' }}">{{ t.nav.home }}</a>
        <a href="{{ (l.prefix + '/about/') | url }}" class="{{ 'active' if page.url == l.prefix + '/about/' }}">{{ t.nav.about }}</a>
        <a href="{{ (l.prefix + '/services/') | url }}" class="{{ 'active' if (page.url | startsWith(l.prefix + '/services/')) }}">{{ t.nav.services }}</a>
        <a href="{{ (l.prefix + '/radiofrecuencia/') | url }}" class="{{ 'active' if page.url == l.prefix + '/radiofrecuencia/' }}">{{ t.nav.radiofrecuencia }}</a>
        <a href="{{ (l.prefix + '/contact/') | url }}" class="{{ 'active' if page.url == l.prefix + '/contact/' }}">{{ t.nav.contact }}</a>
      </nav>

      <div class="header-ctas">
        <div class="lang-switcher" id="langSwitcher">
          <button class="lang-btn" aria-label="Select language" aria-expanded="false" id="langBtn">
            🌐 {{ l.code | upper }} <span class="lang-arrow">▾</span>
          </button>
          <ul class="lang-dropdown" id="langDropdown" role="menu">
            {%- for l2 in langs %}
            <li role="menuitem"><a href="{{ (curEntry.urls[l2.code] if (curEntry and curEntry.urls[l2.code]) else (l2.prefix + '/')) | url }}" data-lang="{{ l2.code }}" data-event="lang_switched" data-event-props='{"from":"{{ l.code }}","to":"{{ l2.code }}"}'>{{ l2.flag }} {{ l2.name }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-terra">{{ t.header.bookCta }}</a>
        <a href="{{ t.header.waHref }}" class="header-wa-btn" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" data-event="whatsapp_clicked" data-event-props='{"location":"header"}'>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347ZM12.05 21.785h-.01a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.16 12.04C2.16 6.58 6.58 2.16 12.05 2.16c2.66 0 5.16 1.036 7.04 2.92a9.88 9.88 0 0 1 2.91 7.04c-.004 5.46-4.424 9.88-9.88 9.88l-.07-.015ZM20.52 3.449C18.24 1.245 15.24 0 12.05 0 5.464 0 .104 5.334.1 11.893c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.422-8.449Z"/></svg>
        </a>
      </div>

      <button class="menu-toggle" id="menuToggle" aria-label="{{ t.header.menuToggle }}">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  {{ content | safe }}

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-brand">
          <a href="{{ (l.prefix + '/') | url }}" aria-label="AnyLopez">
            <picture>
              <source srcset="{{ '/images/logo-color-sin-fondo.webp' | url }}" type="image/webp">
              <img src="{{ '/images/logo-color-sin-fondo.png' | url }}" alt="AnyLopez" class="footer-logo-img" width="135" height="100" loading="lazy" decoding="async" />
            </picture>
          </a>
          <p>{{ t.footer.brand }}</p>
          <div class="social-links">
            <a href="https://www.instagram.com/anylopez.estetica/" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
            </a>
            <a href="https://www.facebook.com/anylopezclinica" class="social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12Z"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <p class="footer-heading">{{ t.footer.servicesHeading }}</p>
          <ul>
            {%- for path, label in t.footer.servicesLinks %}
            <li><a href="{{ (l.prefix + path) | url }}">{{ label }}</a></li>
            {%- endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-heading">{{ t.footer.infoHeading }}</p>
          <ul>
            {%- for path, label in t.footer.infoLinks %}
            <li><a href="{{ (l.prefix + path) | url }}">{{ label }}</a></li>
            {%- endfor %}
          </ul>
          <div style="margin-top:1.2rem;">
            <a href="https://maps.app.goo.gl/v1Hvp48bfh3E7d86A" target="_blank" rel="noopener noreferrer" class="footer-google-link">
              <span class="footer-stars">★★★★★</span> {{ reviews.count }} {{ t.footer.googleReviews }}
            </a>
          </div>
        </div>

        <div class="footer-col">
          <p class="footer-heading">{{ t.footer.contactHeading }}</p>
          <p>C/ Marqués de Comillas 4<br>Local 6, Benidorm</p>
          <p><a href="tel:656306167" data-event="phone_clicked" data-event-props='{"location":"footer","number":"656306167"}'>656 306 167</a></p>
          <p><a href="tel:865710769" data-event="phone_clicked" data-event-props='{"location":"footer","number":"865710769"}'>865 710 769</a></p>
          <p><a href="mailto:info@anylopez.com">info@anylopez.com</a></p>
          <p>{{ t.footer.hours }}</p>
        </div>

      </div>
      <div class="footer-bottom">
        <p>© 2026 AnyLopez Clínica Estética · Benidorm · {{ t.footer.rights }}</p>
        <p class="footer-legal-links">
          <a href="{{ '/privacidad/' | url }}">{{ t.footer.privacyLabel }}</a>
          <span aria-hidden="true">·</span>
          <a href="{{ '/aviso-legal/' | url }}">{{ t.footer.legalLabel }}</a>
        </p>
      </div>
    </div>
  </footer>


  <!-- MOBILE STICKY BAR -->
  <div class="mobile-bar">
    <a href="tel:656306167" class="mobile-bar-btn" data-event="phone_clicked" data-event-props='{"location":"mobile-bar","number":"656306167"}'>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C9.6 21 3 14.4 3 6c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
      {{ t.mobileBar.call }}
    </a>
    <a href="{{ t.header.waHref }}" class="mobile-bar-btn" target="_blank" rel="noopener noreferrer" data-event="whatsapp_clicked" data-event-props='{"location":"mobile-bar"}'>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347ZM12.05 21.785h-.01a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.16 12.04C2.16 6.58 6.58 2.16 12.05 2.16c2.66 0 5.16 1.036 7.04 2.92a9.88 9.88 0 0 1 2.91 7.04c-.004 5.46-4.424 9.88-9.88 9.88l-.07-.015ZM20.52 3.449C18.24 1.245 15.24 0 12.05 0 5.464 0 .104 5.334.1 11.893c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.422-8.449Z"/></svg>
      WhatsApp
    </a>
  </div>

  <script id="pages-i18n-map" type="application/json">{
    {%- set _first = true -%}
    {%- for p in pagesI18n -%}
      {%- if p.urls.en -%}
        {%- if not _first %},{% endif -%}
        "{{ p.urls.es | url }}": "{{ p.urls.en | url }}"
        {%- set _first = false -%}
      {%- endif -%}
    {%- endfor %}
  }</script>

  <anylopez-chat data-endpoint="https://anylopez-chat.anylopez.workers.dev"></anylopez-chat>
  <script src="{{ '/assets/chat/widget.min.js' | url | bust }}" defer></script>
  <script src="{{ '/assets/js/base.js' | url | bust }}" defer></script>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="{{ site.umamiWebsiteId }}"></script>
  <script src="{{ '/assets/js/tracking.js' | url | bust }}" defer></script>
</body>
</html>
