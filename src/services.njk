---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: l
pageCss: services
permalink: "{{ l.prefix }}/services/"
eleventyComputed:
  lang: "{{ l.code }}"
  locale: "{{ l.locale }}"
  title: "{{ i18n[l.code].services.title | safe }}"
  description: "{{ i18n[l.code].services.description | safe }}"
---
{%- set tx = i18n[l.code].services %}
{%- set tdata = catalogo[l.code] %}
{%- set catalogText = i18n[l.code].partials.catalog %}
{% import "price-from.njk" as p %}
<!-- BREADCRUMB -->
<div class="breadcrumb">
  <div class="container">
    <a href="{{ (l.prefix + '/') | url }}">{{ i18n[l.code].chrome.breadcrumbHome }}</a>
    <span>›</span>
    <span>{{ tx.breadcrumb }}</span>
  </div>
</div>

<!-- HERO -->
<section class="svc-hero">
  <div class="container">
    <span class="eyebrow">{{ tx.hero.eyebrow }}</span>
    <h1>{{ tx.hero.h1_html | safe }}</h1>
  </div>
</section>

<!-- CARTA DE TRATAMIENTOS -->
<section class="svc-index">
  <div class="container">
    <nav class="svc-nav" aria-label="{{ tx.nav.categories }}">
      <ul class="svc-chips">
        {%- for cat in tdata.categorias %}
        <li><a class="svc-chip" href="#{{ cat.id }}" data-cat="{{ cat.id }}">{{ cat.nombre }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="svc-goals" hidden>
      <p class="svc-goals-label" id="svc-goals-label">{{ tx.nav.goalsLabel }}</p>
      <ul class="svc-chips" aria-labelledby="svc-goals-label">
        <li><button type="button" class="svc-chip" data-goal="" aria-pressed="true" data-event="treatment_goal_filtered" data-event-props='{"goal":"all"}'>{{ tx.nav.all }}</button></li>
        {%- for goal in catalogo.objetivos %}
        <li><button type="button" class="svc-chip" data-goal="{{ goal.id }}" aria-pressed="false" data-event="treatment_goal_filtered" data-event-props='{"goal":"{{ goal.id }}"}'>{{ tx.goals[goal.id] }}</button></li>
        {%- endfor %}
      </ul>
      <p class="svc-count" role="status" data-template="{{ tx.list.count }}"></p>
    </div>

    {%- for cat in tdata.categorias %}
    <section class="svc-group" id="{{ cat.id }}">
      <header class="svc-group-head">
        <h2><a href="{{ (l.prefix + '/services/' + cat.id + '/') | url }}">{{ cat.nombre }}</a></h2>
        {%- if cat.id == "lifting-antiaging" %}<span class="svc-group-flag">{{ tx.list.flag }}</span>{% endif %}
        <p class="svc-group-desc">{{ cat.descripcion }}</p>
      </header>
      <ul class="svc-rows">
        {%- for t in tdata.tratamientos | byCategory(cat.id) %}
        <li>
          <a class="svc-row" href="{{ (l.prefix + '/services/' + cat.id + '/#' + t.slug) | url }}" data-slug="{{ t.slug }}">
            <span class="svc-row-name">{{ t.nombre }}</span>
            <span class="svc-row-meta">{{ t.duracion }}</span>
            {{ p.priceFrom(preciosDesde[t.slug], catalogText.from) }}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endfor %}
  </div>
</section>

<section class="svc-intro">
  <div class="container">
    <p class="lead">{{ tx.hero.lead_html | safe }}</p>
    <div class="svc-hero-meta">
      <span class="svc-hero-stars">★★★★★</span>
      <strong>{{ tx.hero.reviews_html | replace("{rating}", reviews.rating) | replace("{count}", reviews.count) | safe }}</strong>
      <span class="dot">·</span>
      <span>{{ tdata.tratamientos | length }} {{ tx.hero.treatments }}</span>
      <span class="dot">·</span>
      <span>{{ tx.hero.free }}</span>
    </div>
  </div>
</section>

<script type="application/json" id="svc-goals-data">{{ catalogo.objetivos | dump | safe }}</script>

<!-- TRUST STRIP -->
<section class="svc-trust">
  <div class="container">
    <div class="svc-trust-stars">★★★★★</div>
    <div class="svc-trust-rating"><strong>{{ reviews.rating }}</strong> · {{ reviews.count }} {{ tx.trust.reviews }}</div>
    <div class="svc-trust-sub">{{ tx.trust.sub }}</div>
  </div>
</section>

<!-- FLAGSHIP — {{ tx.flagship.comment }} -->
<section class="svc-flagship">
  <div class="container">
    <div class="svc-flagship-grid">
      <div class="svc-flagship-img">
        <picture>
          <source srcset="{{ '/images/fotoscatalogoanylopez/radiofrecuenciacorporal.webp' | url }}" type="image/webp">
          <img
            src="{{ '/images/fotoscatalogoanylopez/radiofrecuenciacorporal.png' | url }}"
            alt="{{ tx.flagship.alt }}"
            loading="lazy"
            decoding="async"
            width="800"
            height="1000"
          />
        </picture>
      </div>
      <div>
        <span class="eyebrow" style="color: var(--gold);">{{ tx.flagship.eyebrow }}</span>
        <h2>{{ tx.flagship.h2_html | safe }}</h2>
        <p>{{ tx.flagship.p_html | safe }}</p>
        <div class="svc-flagship-meta">
          <div class="svc-flagship-meta-item">
            <strong>{{ tx.flagship.m1v }}</strong>
            {{ tx.flagship.m1l }}
          </div>
          <div class="svc-flagship-meta-item">
            <strong>{{ tx.flagship.m2v }}</strong>
            {{ tx.flagship.m2l }}
          </div>
          <div class="svc-flagship-meta-item">
            <strong>{{ tx.flagship.m3v }}</strong>
            {{ tx.flagship.m3l }}
          </div>
        </div>
        <a href="{{ (l.prefix + '/radiofrecuencia/') | url }}" class="btn btn-accent">{{ tx.flagship.cta }}</a>
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="svc-final-cta">
  <div class="container">
    <span class="eyebrow">{{ tx.finalCta.eyebrow }}</span>
    <h2>{{ tx.finalCta.h2_html | safe }}</h2>
    <p>{{ tx.finalCta.p_html | safe }}</p>
    <div class="svc-final-cta-row">
      <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-accent">{{ tx.finalCta.btn }}</a>
      {{ tx.finalCta.wa_html | safe }}
    </div>
  </div>
</section>

<!-- JSON-LD: ItemList of categories -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ tx.jsonld.name | dump | safe }},
  "numberOfItems": {{ tdata.categorias | length }},
  "itemListElement": [
    {%- for cat in tdata.categorias -%}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "item": {
        "@type": "MedicalSpecialty",
        "name": {{ cat.nombre | dump | safe }},
        "description": {{ cat.descripcion | dump | safe }},
        "url": "{{ site.url }}{{ l.prefix }}/services/{{ cat.id }}/"
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

<!-- TREATMENT MODAL (shared partial — drives data-slug triggers) -->
{%- set tratamientos = tdata %}
{% include "treatment-modal.njk" %}
<script src="{{ '/js/services-filter.js' | url | bust }}" defer></script>
