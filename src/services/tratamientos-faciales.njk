---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: l
permalink: "{{ l.prefix }}/services/tratamientos-faciales/"
eleventyComputed:
  lang: "{{ l.code }}"
  locale: "{{ l.locale }}"
  title: "{{ i18n[l.code]['svc-tratamientos-faciales'].title | safe }}"
  description: "{{ i18n[l.code]['svc-tratamientos-faciales'].description | safe }}"
---
{%- set tx = i18n[l.code]['svc-tratamientos-faciales'] %}
{%- set tdata = catalogo[l.code] %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalSpecialty",
  "name": "{{ tx.jsonld.name | safe }}",
  "alternateName": "{{ tx.jsonld.alternateName | safe }}",
  "description": "{{ tx.jsonld.description | safe }}",
  "url": "{{ site.url }}{{ l.prefix }}/services/tratamientos-faciales/",
  "relevantSpecialty": ["https://schema.org/Dermatologic", "https://schema.org/PlasticSurgery"],
  "provider": { "@id": "{{ site.url }}/#clinic" }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
{%- for f in tx.jsonld.faq %}
    { "@type": "Question", "name": "{{ f.q | safe }}", "acceptedAnswer": { "@type": "Answer", "text": "{{ f.a | safe }}" } }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
</script>

<style>
  /* ─── HERO CINEMATIC ──────────────────────────────── */
  .cat-page-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .cat-page-hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cat-page-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .cat-page-hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(26,18,8,0.78) 0%, rgba(26,18,8,0.55) 50%, rgba(26,18,8,0.25) 100%);
  }
  .cat-page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 120px 0;
  }
  .cat-page-hero-content { max-width: 720px; }
  .cat-page-hero h1 {
    color: #fff;
    font-size: clamp(40px, 6.5vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 16px 0 20px;
  }
  .cat-page-hero h1 em { font-style: italic; color: var(--gold); }
  .cat-page-hero .lead {
    color: rgba(255,255,255,0.88);
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 32px;
  }
  .cat-page-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .cat-page-hero-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    color: rgba(255,255,255,0.78);
    font-size: 13px;
  }
  .cat-page-hero-meta strong { color: #fff; }
  .cat-page-hero-meta .stars { color: var(--gold); letter-spacing: 1px; font-size: 14px; }
  .cat-page-hero-meta .dot { color: rgba(255,255,255,0.35); }

  /* ─── PAIN POINTS ─────────────────────────────────── */
  .cat-page-pain {
    background: var(--ivory);
    padding: 96px 0;
  }
  .cat-page-pain-head { text-align: center; max-width: 680px; margin: 0 auto 64px; }
  .cat-page-pain-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .cat-page-pain-head p { color: var(--text-mid); font-size: 16px; }
  .cat-page-pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .cat-page-pain-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 36px 32px;
    transition: border-color 0.3s var(--ease);
  }
  .cat-page-pain-item:hover { border-color: var(--terra); }
  .cat-page-pain-item h3 {
    font-size: 22px;
    line-height: 1.25;
    margin-bottom: 14px;
    color: var(--dark);
  }
  .cat-page-pain-item p { color: var(--text-mid); font-size: 14px; line-height: 1.6; }

  /* ─── WHY IT WORKS — 6 reasons numbered ───────────── */
  .cat-page-why {
    background: var(--sand);
    padding: 96px 0;
  }
  .cat-page-why-head { max-width: 680px; margin: 0 auto 64px; text-align: center; }
  .cat-page-why-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .cat-page-why-head p { color: var(--text-mid); font-size: 16px; }
  .cat-page-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 64px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .cat-page-reason { display: flex; gap: 20px; }
  .cat-page-reason-num {
    flex-shrink: 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 44px;
    line-height: 1;
    color: var(--terra);
    font-weight: 500;
    margin-top: -4px;
  }
  .cat-page-reason-body h3 {
    font-size: 22px;
    margin-bottom: 10px;
    line-height: 1.25;
    color: var(--dark);
  }
  .cat-page-reason-body p { color: var(--text-mid); font-size: 14.5px; line-height: 1.65; }

  /* ─── TREATMENTS GRID ─────────────────────────────── */
  .cat-page-grid-section {
    padding: 96px 0;
    background: var(--ivory);
  }
  .cat-page-grid-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
  .cat-page-grid-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .cat-page-grid-head p { color: var(--text-mid); font-size: 16px; }
  .cat-page-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .trat-card {
    background: #fff;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    scroll-margin-top: 160px;
    cursor: pointer;
  }
  .trat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .trat-card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    background: var(--bg-light);
  }
  .trat-card-body { padding: 24px; flex: 1; display: flex; flex-direction: column; gap: 12px; }
  .trat-card-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    line-height: 1.3;
    color: var(--dark);
    margin: 0;
  }
  .trat-card-desc { font-size: 13px; line-height: 1.65; color: var(--text-mid); margin: 0; }
  .trat-card-incluye { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .trat-card-incluye li {
    font-size: 12px;
    color: var(--text-mid);
    padding-inline-start: 14px;
    position: relative;
    line-height: 1.5;
  }
  .trat-card-incluye li::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    color: var(--terra);
    font-weight: 700;
    font-size: 11px;
  }
  .trat-card-meta {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .trat-duracion {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--text-mid);
    text-transform: uppercase;
  }
  .trat-duracion svg { width: 13px; height: 13px; flex-shrink: 0; stroke: var(--terra); }
  .trat-cta {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--terra-dk);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .trat-cta:hover { color: var(--terra); }

  /* ─── CROSS-SELL BAND ─────────────────────────────── */
  .cat-page-cross {
    background: var(--dark);
    color: #fff;
    padding: 96px 0;
  }
  .cat-page-cross-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
  .cat-page-cross-head .eyebrow { color: var(--gold); }
  .cat-page-cross-head h2 {
    color: #fff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    margin: 12px 0 12px;
  }
  .cat-page-cross-head h2 em { font-style: italic; color: var(--gold); }
  .cat-page-cross-head p { color: rgba(255,255,255,0.78); font-size: 16px; }
  .cat-page-cross-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 880px;
    margin: 0 auto;
  }
  .cat-page-cross-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 2px;
    padding: 36px 32px;
    text-decoration: none;
    color: #fff;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cat-page-cross-card:hover {
    border-color: var(--gold);
    background: rgba(255,255,255,0.06);
  }
  .cat-page-cross-card .eyebrow { color: var(--gold); }
  .cat-page-cross-card h3 {
    color: #fff;
    font-size: 24px;
    line-height: 1.25;
    margin: 0 0 4px;
  }
  .cat-page-cross-card h3 em { font-style: italic; color: var(--gold); }
  .cat-page-cross-card p { color: rgba(255,255,255,0.78); font-size: 14px; line-height: 1.6; margin: 0; }
  .cat-page-cross-card .arrow {
    margin-top: auto;
    padding-top: 16px;
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ─── TESTIMONIOS ────────────────────────────────── */
  .cat-page-tests {
    background: var(--ivory);
    padding: 96px 0;
  }
  .cat-page-tests-head { text-align: center; max-width: 680px; margin: 0 auto 56px; }
  .cat-page-tests-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .cat-page-tests-head p { color: var(--text-mid); font-size: 15px; }
  .cat-page-tests-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .cat-page-test {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .cat-page-test-stars { color: var(--gold); font-size: 16px; letter-spacing: 1px; margin-bottom: 16px; }
  .cat-page-test-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    line-height: 1.45;
    color: var(--dark);
    font-style: italic;
    margin-bottom: 24px;
    flex: 1;
  }
  .cat-page-test-author {
    font-size: 13px;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .cat-page-test-meta { font-size: 12px; color: var(--text-mid); letter-spacing: 0.04em; }

  /* ─── PROCESS ─────────────────────────────────────── */
  .cat-page-process {
    background: var(--sand);
    padding: 96px 0;
  }
  .cat-page-process-head { text-align: center; max-width: 680px; margin: 0 auto 64px; }
  .cat-page-process-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0 16px;
  }
  .cat-page-process-head p { color: var(--text-mid); font-size: 16px; }
  .cat-page-steps { max-width: 800px; margin: 0 auto; }
  .cat-page-step {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }
  .cat-page-step:last-child { border-bottom: none; }
  .cat-page-step-num {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--terra);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 500;
  }
  .cat-page-step-body h3 { font-size: 22px; margin-bottom: 8px; color: var(--dark); }
  .cat-page-step-body p { color: var(--text-mid); font-size: 15px; line-height: 1.6; }

  /* ─── FAQ ─────────────────────────────────────────── */
  .cat-page-faq {
    background: var(--ivory);
    padding: 96px 0;
  }
  .cat-page-faq-head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
  .cat-page-faq-head h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    margin: 12px 0;
  }
  .cat-page-faq-list { max-width: 800px; margin: 0 auto; }
  .cat-page-faq-item {
    border-bottom: 1px solid var(--border);
  }
  .cat-page-faq-q {
    width: 100%;
    background: none;
    border: none;
    padding: 24px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--dark);
    text-align: start;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    line-height: 1.3;
  }
  .cat-page-faq-q .icon {
    flex-shrink: 0;
    font-size: 22px;
    color: var(--terra);
    transition: transform 0.3s var(--ease);
  }
  .cat-page-faq-item.open .cat-page-faq-q .icon { transform: rotate(45deg); }
  .cat-page-faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    color: var(--text-mid);
    font-size: 15.5px;
    line-height: 1.7;
  }
  .cat-page-faq-item.open .cat-page-faq-a {
    max-height: 600px;
    padding: 0 0 28px;
  }

  /* ─── FINAL CTA ───────────────────────────────────── */
  .cat-page-final {
    padding: 120px 0;
    background: var(--dark);
    color: #fff;
    text-align: center;
  }
  .cat-page-final h2 {
    color: #fff;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    max-width: 760px;
    margin: 0 auto 20px;
  }
  .cat-page-final h2 em { font-style: italic; color: var(--gold); }
  .cat-page-final p {
    color: rgba(255,255,255,0.78);
    font-size: 17px;
    max-width: 540px;
    margin: 0 auto 36px;
  }
  .cat-page-final-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ─── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 1024px) {
    .cat-page-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .cat-page-pain-grid { grid-template-columns: 1fr; gap: 20px; }
    .cat-page-why-grid { grid-template-columns: 1fr; gap: 32px; }
    .cat-page-tests-grid { grid-template-columns: 1fr; }
    .cat-page-cross-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cat-page-hero-inner { padding: 80px 0; }
    .cat-page-pain, .cat-page-why, .cat-page-grid-section, .cat-page-cross, .cat-page-tests, .cat-page-process, .cat-page-faq, .cat-page-final { padding: 64px 0; }
    .cat-page-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- BREADCRUMB -->
<div class="breadcrumb">
  <div class="container">
    <a href="{{ (l.prefix + '/') | url }}">{{ i18n[l.code].chrome.breadcrumbHome }}</a>
    <span>›</span>
    <a href="{{ (l.prefix + '/services/') | url }}">{{ tx.breadcrumb.services }}</a>
    <span>›</span>
    <span>{{ tx.breadcrumb.current }}</span>
  </div>
</div>

<!-- HERO CINEMATIC -->
<section class="cat-page-hero">
  <div class="cat-page-hero-img">
    <picture>
      <source srcset="{{ '/images/fotoscatalogoanylopez/dermapen.webp' | url }}" type="image/webp">
      <img
        src="{{ '/images/fotoscatalogoanylopez/dermapen.png' | url }}"
        alt="{{ tx.hero.imgAlt }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1920"
        height="1080"
      />
    </picture>
  </div>
  <div class="cat-page-hero-inner">
    <div class="container">
      <div class="cat-page-hero-content">
        <span class="eyebrow" style="color: var(--gold);">{{ tx.hero.eyebrow }}</span>
        <h1>{{ tx.hero.h1_html | safe }}</h1>
        <p class="lead">{{ tx.hero.lead_html | safe }}</p>
        <div class="cat-page-hero-ctas">
          <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-accent">{{ tx.hero.ctaPrimary }}</a>
          <a href="tel:+34656306167" class="btn btn-outline-white">{{ tx.callCta }}</a>
        </div>
        <div class="cat-page-hero-meta">
          <span class="stars">★★★★★</span>
          <strong>{{ reviews.rating }} · {{ reviews.count }} {{ tx.hero.reviews }}</strong>
          <span class="dot">·</span>
          <span>{{ tx.hero.free }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAIN POINTS -->
<section class="cat-page-pain">
  <div class="container">
    <div class="cat-page-pain-head">
      <span class="eyebrow">{{ tx.pain.eyebrow }}</span>
      <h2>{{ tx.pain.h2 }}</h2>
      <p>{{ tx.pain.p_html | safe }}</p>
    </div>
    <div class="cat-page-pain-grid">
      {%- for it in tx.pain.items %}
      <div class="cat-page-pain-item">
        <h3>{{ it.h3_html | safe }}</h3>
        <p>{{ it.p_html | safe }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- WHY IT WORKS -->
<section class="cat-page-why">
  <div class="container">
    <div class="cat-page-why-head">
      <span class="eyebrow">{{ tx.why.eyebrow }}</span>
      <h2>{{ tx.why.h2 }}</h2>
      <p>{{ tx.why.p_html | safe }}</p>
    </div>
    <div class="cat-page-why-grid">
      {%- for it in tx.why.items %}
      <div class="cat-page-reason">
        <div class="cat-page-reason-num">0{{ loop.index }}</div>
        <div class="cat-page-reason-body">
          <h3>{{ it.h3_html | safe }}</h3>
          <p>{{ it.p_html | safe }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- TREATMENTS GRID -->
<section class="cat-page-grid-section">
  <div class="container">
    <div class="cat-page-grid-head">
      <span class="eyebrow">{{ tx.grid.eyebrow }}</span>
      <h2>{{ tx.grid.h2 }}</h2>
      <p>{{ tx.grid.p_html | safe }}</p>
    </div>
    <div class="cat-page-grid">
      {%- set facialTrats = tdata.tratamientos | byCategory("tratamientos-faciales") -%}
      {% for trat in facialTrats %}
      <article id="{{ trat.slug }}" class="trat-card" data-slug="{{ trat.slug }}">
        <picture>
          <source srcset="{{ ('/images/tratamientos/' + trat.imagen.replace('.png', '.webp')) | url }}" type="image/webp">
          <img
            src="{{ ('/images/tratamientos/' + trat.imagen) | url }}"
            alt="{{ trat.nombre }}"
            class="trat-card-img"
            loading="lazy"
            decoding="async"
            width="400"
            height="200"
          />
        </picture>
        <div class="trat-card-body">
          <h3 class="trat-card-name">{{ trat.nombre }}</h3>
          <p class="trat-card-desc">{{ trat.descripcion }}</p>

          {% if trat.incluye %}
          <ul class="trat-card-incluye">
            {% for item in trat.incluye %}{% if loop.index <= 3 %}
            <li>{{ item }}</li>
            {% endif %}{% endfor %}
          </ul>
          {% endif %}

          <div class="trat-card-meta">
            <span class="trat-duracion">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {{ trat.duracion }}
            </span>
            <button
              type="button"
              class="trat-cta trat-card-trigger"
              data-slug="{{ trat.slug }}"
              aria-label="{{ tx.grid.detailsAria }} {{ trat.nombre }}"
            >{{ tx.grid.detailsCta }}</button>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CROSS-SELL BAND -->
<section class="cat-page-cross">
  <div class="container">
    <div class="cat-page-cross-head">
      <span class="eyebrow">{{ tx.cross.eyebrow }}</span>
      <h2>{{ tx.cross.h2_html | safe }}</h2>
