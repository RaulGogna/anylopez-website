---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: l
permalink: "{{ l.prefix }}/about/"
eleventyComputed:
  lang: "{{ l.code }}"
  locale: "{{ l.locale }}"
  title: "{{ i18n[l.code].about.title | safe }}"
  description: "{{ i18n[l.code].about.description | safe }}"
---
{%- set ta = i18n[l.code].about %}
  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <div class="container">
      <a href="{{ (l.prefix + '/') | url }}">{{ i18n[l.code].chrome.breadcrumbHome }}</a>
      <span>›</span>
      <span>{{ ta.breadcrumb }}</span>
    </div>
  </div>

  <!-- PAGE HERO -->
  <section class="page-hero" style="position:relative; background-image:url('{{ "/images/about/fondo-web-2.webp" | url }}'); background-size:cover; background-position:center;">
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(28,26,24,0.78) 0%,rgba(28,26,24,0.52) 100%);"></div>
    <div class="container" style="position:relative;z-index:2;">
      <span class="section-label" style="color:var(--accent)">{{ ta.hero.label }}</span>
      <h1>{{ ta.hero.h1 }}</h1>
      <p>{{ ta.hero.sub }}</p>
    </div>
  </section>

  <!-- HISTORIA -->
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <span class="section-label">{{ ta.historia.label }}</span>
          <h2 class="section-title">{{ ta.historia.h2 }}</h2>
          <p style="color:var(--text-mid); margin-bottom:20px;">{{ ta.historia.p1 }}</p>
          <p style="color:var(--text-mid); margin-bottom:32px;">{{ ta.historia.p2 }}</p>
          <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-primary">{{ ta.historia.cta }}</a>
        </div>
        <div style="position:relative;">
          <picture>
            <source srcset="{{ '/images/about/image-and-text-1.webp' | url }}" type="image/webp">
            <img
              src="{{ '/images/about/image-and-text-1.jpg' | url }}"
              alt="{{ ta.historia.imgAlt }}"
              loading="lazy"
              decoding="async"
              style="border-radius:16px; width:100%; object-fit:cover; height:420px;"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="section section--bg">
    <div class="container">
      <div class="text-center">
        <span class="section-label">{{ ta.valores.label }}</span>
        <h2 class="section-title">{{ ta.valores.h2 }}</h2>
      </div>
      <div class="grid-3">
        {%- set romanos = ["I", "II", "III"] %}
        {%- for item in ta.valores.items %}
        <div class="value-card">
          <div class="value-icon" style="font-family:'Cormorant Garamond',serif;font-style:italic;">{{ romanos[loop.index0] }}</div>
          <h3>{{ item.h3 }}</h3>
          <p>{{ item.p }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ESTADÍSTICAS -->
  <section class="section section--dark">
    <div class="container">
      <div class="stats-grid">
        <div>
          <div class="stat-number">35+</div>
          <div class="stat-label">{{ ta.stats.experiencia }}</div>
        </div>
        <div>
          <div class="stat-number">{{ reviews.rating }} ★</div>
          <div class="stat-label">{{ ta.stats.rating }}</div>
        </div>
        <div>
          <div class="stat-number">{{ reviews.count }}</div>
          <div class="stat-label">{{ ta.stats.resenas }}</div>
        </div>
        <div>
          <div class="stat-number">10+</div>
          <div class="stat-label">{{ ta.stats.tratamientos }}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPO -->
  <section class="section">
    <div class="container">
      <div class="text-center">
        <span class="section-label">{{ ta.equipo.label }}</span>
        <h2 class="section-title">{{ ta.equipo.h2 }}</h2>
        <p class="section-subtitle">{{ ta.equipo.sub }}</p>
      </div>
      <div class="grid-4">
        <div class="team-card">
          <picture>
            <source srcset="{{ '/images/kumar-bata-sonrisa-elegancia.webp' | url }}" type="image/webp">
            <img
              src="{{ '/images/kumar-bata-sonrisa-elegancia.jpeg' | url }}"
              alt="Gogna Kumar"
              class="team-img"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h3 class="team-name">Gogna Kumar</h3>
          <p class="team-role">{{ ta.equipo.roles.kumar }}</p>
        </div>
        <div class="team-card">
          <picture>
            <source srcset="{{ '/images/about/team-member-2.webp' | url }}" type="image/webp">
            <img
              src="{{ '/images/about/team-member-2.jpg' | url }}"
              alt="Eilen Vanessa Cardenas"
              class="team-img"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h3 class="team-name">Eilen Vanessa Cardenas</h3>
          <p class="team-role">{{ ta.equipo.roles.eilen_html | safe }}</p>
        </div>
        <div class="team-card">
          <picture>
            <source srcset="{{ '/images/about/doctor-2.webp' | url }}" type="image/webp">
            <img
              src="{{ '/images/about/doctor-2.png' | url }}"
              alt="Dr. Jose Rius"
              class="team-img"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h3 class="team-name">Dr. Jose Rius</h3>
          <p class="team-role">{{ ta.equipo.roles.rius }}</p>
        </div>
        <div class="team-card">
          <picture>
            <source srcset="{{ '/images/about/team-member-5.webp' | url }}" type="image/webp">
            <img
              src="{{ '/images/about/team-member-5.jpg' | url }}"
              alt="Olga Topchevod"
              class="team-img"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h3 class="team-name">Olga Topchevod</h3>
          <p class="team-role">{{ ta.equipo.roles.olga }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTALACIONES -->
  <section class="section section--bg">
    <div class="container">
      <div class="text-center">
        <span class="section-label">{{ ta.instalaciones.label }}</span>
        <h2 class="section-title">{{ ta.instalaciones.h2 }}</h2>
        <p class="section-subtitle">{{ ta.instalaciones.sub }}</p>
      </div>
      <div class="grid-3" style="margin-top:40px;">
        <div>
          <picture>
            <source srcset="{{ '/images/clinica/recepcion.webp' | url }}" type="image/webp">
            <img src="{{ '/images/clinica/recepcion.jpeg' | url }}" alt="{{ ta.instalaciones.recepcionAlt }}" width="640" height="280" loading="lazy" decoding="async" style="width:100%; height:280px; object-fit:cover; border-radius:12px;" />
          </picture>
          <p style="text-align:center; margin-top:12px; color:var(--text-mid); font-size:0.85rem; font-family:'Jost',sans-serif; letter-spacing:0.05em; text-transform:uppercase;">{{ ta.instalaciones.recepcion }}</p>
        </div>
        <div>
          <picture>
            <source srcset="{{ '/images/clinica/salaespera.webp' | url }}" type="image/webp">
            <img src="{{ '/images/clinica/salaespera.jpeg' | url }}" alt="{{ ta.instalaciones.salaAlt }}" width="640" height="280" loading="lazy" decoding="async" style="width:100%; height:280px; object-fit:cover; border-radius:12px;" />
          </picture>
          <p style="text-align:center; margin-top:12px; color:var(--text-mid); font-size:0.85rem; font-family:'Jost',sans-serif; letter-spacing:0.05em; text-transform:uppercase;">{{ ta.instalaciones.sala }}</p>
        </div>
        <div>
          <picture>
            <source srcset="{{ '/images/clinica/cabina2.webp' | url }}" type="image/webp">
            <img src="{{ '/images/clinica/cabina2.jpeg' | url }}" alt="{{ ta.instalaciones.cabinaAlt }}" width="640" height="280" loading="lazy" decoding="async" style="width:100%; height:280px; object-fit:cover; border-radius:12px;" />
          </picture>
          <p style="text-align:center; margin-top:12px; color:var(--text-mid); font-size:0.85rem; font-family:'Jost',sans-serif; letter-spacing:0.05em; text-transform:uppercase;">{{ ta.instalaciones.cabina }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <h2 class="section-title" style="color:#fff; margin-bottom:16px;">{{ ta.cta.h2 }}</h2>
      <p style="color:rgba(255,255,255,0.8); margin-bottom:12px;">{{ ta.cta.p }}</p>
      <p style="color:rgba(255,255,255,0.55); font-size:14px; margin-bottom:32px;">{{ ta.cta.google_html | replace("{count}", reviews.count) | safe }}</p>
      {{ ta.cta.btn_html | replace("{contactUrl}", (l.prefix + '/contact/') | url) | safe }}
    </div>
  </section>
