---
layout: base.njk
pagination:
  data: langs
  size: 1
  alias: l
permalink: "{{ l.prefix }}/"
eleventyComputed:
  lang: "{{ l.code }}"
  locale: "{{ l.locale }}"
  title: "{{ i18n[l.code].home.title | safe }}"
  description: "{{ i18n[l.code].home.description | safe }}"
  ogTitle: "{{ i18n[l.code].home.ogTitle | safe }}"
  ogDescription: "{% if i18n[l.code].home.ogDescPre %}{{ i18n[l.code].home.ogDescPre | safe }}{{ reviews.count }}{{ i18n[l.code].home.ogDescPost | safe }}{% endif %}"
---
{%- set tx = i18n[l.code].home %}
<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <span class="hero-eyebrow">{{ tx.hero.eyebrow }}</span>
    <h1 class="hero-title">{{ tx.hero.h1_html | safe }}</h1>
    <p class="hero-desc">{{ tx.hero.desc }}</p>
    <div class="hero-actions">
      <a href="{{ tx.hero.waHref }}" class="btn btn-terra" target="_blank" rel="noopener noreferrer" data-event="whatsapp_clicked" data-event-props='{"location":"hero"}'>{{ tx.hero.waCta }}</a>
      <a href="#pack-indiba" class="btn btn-outline-light">{{ tx.hero.packCta }}</a>
    </div>
    <a class="hero-rating-link" href="https://www.google.com/search?q=AnyLopez+Clinica+Estetica+Benidorm&amp;hl={{ l.code }}" target="_blank" rel="noopener noreferrer" aria-label="{{ tx.hero.aria1_html | safe }}{{ reviews.count }}{{ tx.hero.aria2 }}{{ reviews.rating }}{{ tx.hero.aria3 }}">
      <span class="hero-rating-stars" aria-hidden="true">★★★★★</span>
      <span class="hero-rating-text"><strong>{{ reviews.rating }}</strong> · {{ reviews.count }} {{ tx.hero.ratingSuffix }}</span>
    </a>
    <ul class="hero-chips" aria-label="{{ tx.hero.chipsAria }}">
      {%- for ch in tx.hero.chips %}
      <li class="hero-chip">{{ ch }}</li>
      {%- endfor %}
    </ul>
    <p class="hero-guarantee">{{ tx.hero.guarantee }}</p>
    <div class="scroll-hint" aria-hidden="true"><span class="scroll-hint-line"></span></div>
  </div>
  <div class="hero-right">
    <picture>
      <source media="(max-width: 768px)" srcset="{{ '/images/hero-image-mobile.webp' | url }}" />
      <img src="{{ '/images/hero-image.webp' | url }}" alt="" class="hero-image" fetchpriority="high" decoding="sync" width="400" height="600" aria-hidden="true" />
    </picture>
    <div class="hero-video-overlay"></div>
  </div>
</section>

<!-- {{ tx.c.booking }} -->
{% set lang = l.code %}
{% include "booking.njk" %}

<!-- {{ tx.c.leadStrip }} -->
{% include "lead-strip.njk" %}

<!-- TRUST STRIP -->
<div class="trust-strip">
  <div class="container">
    <div class="trust-inner">
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="rgba(255,255,255,0.9)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span class="trust-text"><strong>{{ reviews.rating }}</strong> Google · {{ reviews.count }} {{ tx.trust.ratingSuffix }}</span>
      </div>
      <div class="trust-item">
        <span class="trust-badge">{{ tx.trust.badge1 }}</span><span class="trust-text"> Certified</span>
      </div>
      <div class="trust-item">
        <span class="trust-badge">Ultherapy HIFU</span><span class="trust-text"> Certified</span>
      </div>
      <div class="trust-item">
        <span class="trust-badge">Dermapen</span><span class="trust-text"> Certified</span>
      </div>
      <div class="trust-item">
        <span class="trust-text">{{ tx.trust.years_html | safe }}</span>
      </div>
    </div>
  </div>
</div>

<!-- DOLOR → SOLUCIÓN AFLUENTE (Slice 3) -->
{% include "dolor-solucion.njk" %}

<!-- {{ tx.c.pack }} -->
<section class="section pack-indiba-section" id="pack-indiba">
  <div class="container">
    <div class="section-header rv">
      <span class="section-label">{{ tx.pack.label }}</span>
      <h2 class="section-title">{{ tx.pack.h2_html | safe }}</h2>
      <p class="section-subtitle">{{ tx.pack.subtitle }}</p>
    </div>

    <div class="pack-grid rv">

      <div class="pack-include">
        <h3>{{ tx.pack.includeH3_html | safe }}</h3>
        <ul class="pack-stack">
          {%- for it in tx.pack.items %}
          <li class="pack-stack-item{% if it.cls %} {{ it.cls }}{% endif %}">
            <div class="pack-stack-head">
              <span class="pack-stack-name">{{ it.name_html | safe }}</span>
              <span class="pack-stack-value">{{ it.value }}</span>
            </div>
            <p class="pack-stack-reason">{{ it.reason_html | safe }}</p>
          </li>
          {%- endfor %}
        </ul>

        <div class="pack-total">
          <p class="pack-total-line">{{ tx.pack.totalLine_html | safe }}</p>
          <p class="pack-total-price">{{ tx.pack.price_html | safe }}</p>
          <p class="pack-total-savings">{{ tx.pack.savings_html | safe }}</p>
        </div>
      </div>

      <div class="pack-table">
        <h3>{{ tx.pack.tableH3 }}</h3>
        <table>
          <thead>
            <tr>
              <th>{{ tx.pack.thOption }}</th>
              <th class="num">{{ tx.pack.thPrice }}</th>
              <th class="num">{{ tx.pack.thPer }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for r in tx.pack.rows %}
            <tr{% if r.hl %} class="pack-row-highlight"{% endif %}>
              <td>{{ r.td }}</td>
              <td class="num{% if r.hl %} terra{% endif %}">{{ r.p }}</td>
              <td class="num{% if r.hl %} terra{% endif %}">{{ r.s }}</td>
            </tr>
            {%- endfor %}
          </tbody>
        </table>

        <p class="pack-note">{{ tx.pack.note }}</p>

        <p class="pack-reason">{{ tx.pack.reason_html | safe }}</p>
      </div>
    </div>

    <div class="section-cta pack-cta rv">
      <a href="{{ tx.pack.waHref }}" class="btn btn-terra" target="_blank" rel="noopener noreferrer" data-event="whatsapp_clicked" data-event-props='{"location":"pack-indiba"}'>{{ tx.pack.waCta }}</a>
    </div>
  </div>
</section>

<!-- {{ tx.c.otros }} -->
<section class="section otros-tratamientos-section">
  <div class="container">
    <div class="rv otros-wrap">
      <p class="otros-intro">{{ tx.otros.intro_html | safe }}</p>
      <div class="otros-chips">
        {%- for ch in tx.otros.chips %}
        <a href="{{ (l.prefix + ch.path) | url }}" class="otros-chip">{{ ch.label }}</a>
        {%- endfor %}
      </div>
      <a href="{{ (l.prefix + '/services/') | url }}" class="btn btn-outline-terra">{{ tx.otros.catalogCta }}</a>
    </div>
  </div>
</section>

<!-- {{ tx.c.porque }} -->
<section class="section porque-section">
  <div class="container">
    <div class="section-header rv">
      <span class="section-label">{{ tx.porque.label }}</span>
      <h2 class="section-title">{{ tx.porque.h2 }}</h2>
    </div>
    <div class="porque-grid">
      <div class="porque-card rv d1">
        <div class="porque-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
        </div>
        <h3>{{ tx.porque.c1.h3 }}</h3>
        <p>{{ tx.porque.c1.p_html | safe }}</p>
      </div>
      <div class="porque-card rv d2">
        <div class="porque-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
        </div>
        <h3>{{ tx.porque.c2.h3 }}</h3>
        <p>{{ tx.porque.c2.p_html | safe }}</p>
      </div>
      <div class="porque-card rv d3">
        <div class="porque-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        </div>
        <h3>{{ tx.porque.c3.h3 }}</h3>
        <p>{{ tx.porque.c3.p_html | safe }}</p>
      </div>
      <div class="porque-card rv d4">
        <div class="porque-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
        </div>
        <h3>{{ tx.porque.c4.h3 }}</h3>
        <p>{{ reviews.count }}{{ tx.porque.c4.p_html | safe }}</p>
      </div>
    </div>
  </div>
</section>

<!-- {{ tx.c.legado }} -->
<section class="section legado-section">
  <div class="container">
    <div class="section-header rv">
      <span class="section-label">{{ tx.legado.label }}</span>
      <h2 class="section-title">{{ tx.legado.h2_html | safe }}</h2>
    </div>
    <div class="legado-grid rv">
      <p>{{ tx.legado.p1_html | safe }}</p>
      <p>{{ tx.legado.p2_html | safe }}</p>
      <p>{{ tx.legado.p3_html | safe }}</p>
    </div>

    <div class="equipo-block rv">
      <div class="equipo-header">
        <span class="section-label">{{ tx.legado.eqLabel }}</span>
      </div>
      <div class="equipo-card">
        <div class="equipo-photo">
          <picture>
            <source srcset="{{ '/images/kumar-bata-sonrisa-elegancia.webp' | url }}" type="image/webp">
            <img src="{{ '/images/kumar-bata-sonrisa-elegancia.jpeg' | url }}" alt="{{ tx.legado.imgAlt }}" width="280" height="280" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="equipo-info">
          <h3>Gogna Kumar</h3>
          <p class="equipo-rol">{{ tx.legado.rol }}</p>
          <p>{{ tx.legado.bio1 }}</p>
          <p class="equipo-bio-last">{{ tx.legado.bio2_html | safe }}</p>
          <a href="{{ tx.legado.waHref }}" class="btn btn-terra" target="_blank" rel="noopener noreferrer" data-event="whatsapp_clicked" data-event-props='{"location":"legacy-team"}'>{{ tx.legado.waCta }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- {{ tx.c.proceso }} -->
<section class="section proceso-section">
  <div class="container">
    <div class="section-header rv">
      <span class="section-label">{{ tx.proceso.label }}</span>
      <h2 class="section-title">{{ tx.proceso.h2 }}</h2>
    </div>
    <div class="proceso-steps">
      {%- for st in tx.proceso.steps %}
      <div class="proceso-step rv d{{ loop.index }}">
        <span class="p-num">0{{ loop.index }}</span>
        <h3>{{ st.h3 }}</h3>
        <p>{{ st.p }}</p>
      </div>
      {%- endfor %}
    </div>
    <div class="section-cta rv">
      <a href="{{ (l.prefix + '/contact/') | url }}" class="btn btn-terra">{{ tx.proceso.ctaLabel }}</a>
    </div>
  </div>
</section>

<!-- {{ tx.c.testi }} -->
<section class="testi-section">
  <div class="container">
    <div class="testi-head rv">
      <div>
        <div class="google-pill">
          <svg width="20" height="20" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a{{ reviews.rating }}6 {{ reviews.rating }}6 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          <div>
            <span class="g-rating-big">{{ reviews.rating }}</span>
            <div class="g-stars">★★★★★</div>
            <div class="g-count">{{ reviews.count }} {{ tx.testi.countSuffix }}</div>
          </div>
        </div>
        <h2 class="rv d1" style="font-family:'Cormorant Garamond',serif;font-size:clamp(36px,5vw,60px);font-weight:300;color:var(--ivory);line-height:1.1;">{{ tx.testi.h2_html | safe }}</h2>
      </div>
      <div class="rv d2" style="display:flex;flex-direction:column;justify-content:flex-end;gap:16px;">
        <p style="font-size:15px;font-weight:300;color:rgba(248,243,237,0.5);line-height:1.8;">{{ tx.testi.introPre }}{{ reviews.count }}{{ tx.testi.introPost }}</p>
        <a href="https://www.google.com/search?q=AnyLopez+Clinica+Estetica+Benidorm&hl={{ l.code }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light" style="align-self:flex-start;">{{ tx.testi.allCta }}</a>
      </div>
    </div>
    <div class="testi-grid rv">
      {%- for t in tx.testi.cards %}
      <div class="t-card{% if t.featured %} featured{% endif %}">
        <div class="t-stars">★★★★★</div>
        <p class="t-quote">{{ t.quote_html | safe }}</p>
        <div class="t-name">{{ t.name }}</div>
        <div class="t-service">{{ t.service }}</div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section faq-section">
  <div class="container">
    <div class="section-header rv">
      <span class="section-label">{{ tx.faq.label }}</span>
      <h2 class="section-title">{{ tx.faq.h2 }}</h2>
    </div>
    <div class="faq-list rv">
      {%- for f in tx.faq.items %}

      <div class="faq-item">
        <input type="checkbox" id="faq{{ loop.index }}" class="faq-check" />
        <label class="faq-label" for="faq{{ loop.index }}">
          {{ f.q_html | safe }}
          <span class="faq-icon" aria-hidden="true"></span>
        </label>
        <div class="faq-answer">
          <p>{{ f.a_html | safe }}</p>
        </div>
      </div>
      {%- endfor %}

    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ tx.jsonldProduct.name | dump | safe }},
  "description": {{ tx.jsonldProduct.description | dump | safe }},
  "image": "{{ site.url }}/images/fotoscatalogoanylopez/radiofrecuenciacorporal.webp",{% if tx.jsonldProduct.inLanguage %}
  "inLanguage": {{ tx.jsonldProduct.inLanguage | dump | safe }},{% endif %}
  "brand": {
    "@type": "Brand",
    "name": {{ tx.jsonldProduct.clinicName | dump | safe }}
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ site.url }}{{ l.prefix }}/#pack-indiba",
    "priceCurrency": "EUR",
    "price": "500",
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "MedicalClinic",
      "name": {{ tx.jsonldProduct.clinicName | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Benidorm",
        "addressRegion": "Alicante",
        "addressCountry": "ES"
      }
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ reviews.rating }}",
    "reviewCount": "{{ reviews.count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",{% if tx.jsonldProduct.inLanguage %}
  "inLanguage": {{ tx.jsonldProduct.inLanguage | dump | safe }},{% endif %}
  "mainEntity": [
    {%- for q in tx.jsonldFaq %}
    {
      "@type": "Question",
      "name": {{ q.name | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ q.text | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

<!-- INSTAGRAM -->
<section class="ig-section">
  <div class="container">
    <div class="ig-header rv">
      <div>
        <span class="section-label">{{ tx.ig.label }}</span>
        <h2 class="ig-title">@<span class="ig-handle">anylopez.estetica</span></h2>
      </div>
      <a href="https://www.instagram.com/anylopez.estetica/" class="btn btn-terra" target="_blank" rel="noopener noreferrer">{{ tx.ig.profileCta }}</a>
    </div>
    <div class="ig-footer rv d1">
      <a href="https://www.instagram.com/anylopez.estetica/" class="btn btn-outline-terra" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        {{ tx.ig.followCta }}
      </a>
    </div>
  </div>
</section>

<!-- {{ tx.c.donde }} -->
<section class="donde-section">
  <div class="container">
    <div class="donde-header rv">
      <span class="section-label">{{ tx.donde.label }}</span>
      <h2 class="section-title">{{ tx.donde.h2_html | safe }}</h2>
    </div>
    <div class="donde-grid">
      <div class="donde-map-wrap rv">
        <button
          type="button"
          class="donde-map-placeholder"
          data-map-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d19{{ reviews.rating }}5200463471965!2d-0.13294496084974686!3d38.53763894033556!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6205c0952b0439%3A0xc134f6679c32e94c!2sAnyLopez%20Clinica%20Est%C3%A9tica!5e0!3m2!1s{{ l.code }}!2ses!4v1777479067286!5m2!1s{{ l.code }}!2ses"
          data-map-title="{{ tx.donde.mapTitle }}"
          aria-label="{{ tx.donde.mapText }}"
        >
          <span class="donde-map-placeholder-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <span class="donde-map-placeholder-text">{{ tx.donde.mapText }}</span>
          <span class="donde-map-placeholder-hint">C/ Marqués de Comillas 4, Local 6 · Benidorm</span>
        </button>
        <a
          href="https://www.google.com/maps/place/AnyLopez+Clinica+Est%C3%A9tica/@38.5376389,-0.1329449,19z"
          target="_blank"
          rel="noopener noreferrer"
          class="donde-map-cta"
          aria-label="{{ tx.donde.openAria }}"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {{ tx.donde.openLabel }}
        </a>
      </div>
      <div class="donde-info rv d1">
        <div>
          <h3 class="donde-info-title">{{ tx.donde.infoTitle }}</h3>
          <p class="donde-info-desc">{{ tx.donde.infoDesc_html | safe }}</p>
          <ul class="donde-meta">
            <li class="donde-meta-item">
              <span class="donde-meta-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span>C/ Marqués de Comillas 4, Local 6 — Benidorm</span>
            </li>
            <li class="donde-meta-item">
              <span class="donde-meta-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
